
@page
@model PartnerCRM.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Přihlášení";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="text-center mb-4">PartnerCRM</h2>

            <p class="text-center text-muted mb-4">
                Přihlášení do systému
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Email"
                           class="form-label">E-mail</label>
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username" />
                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password"
                           class="form-label">Heslo</label>
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password" />
                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Přihlásit se
                </button>
            </form>
            <div class="text-center my-3">
                <span class="text-muted">nebo</span>
            </div>

            <form method="post" asp-page-handler="GoogleLogin">
                <button type="submit"
                        class="btn btn-outline-dark w-100">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                         alt="Google"
                         style="width:20px; margin-right:10px;" />
                    Přihlásit se pomocí Google
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
