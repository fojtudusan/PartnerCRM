
@page
@model PartnerCRM.Pages.Marketing.DetailsModel

@{
    ViewData["Title"] = "Detail marketingové akce";
}

<div class="container-fluid">

    <!-- Hlavička -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@Model.Campaign.Name</h2>
            <p class="text-muted mb-0">
                Detail marketingové akce
            </p>
        </div>

        <div class="d-flex gap-2">

            @if (Model.Campaign.EmailTemplate != null &&
                 Model.Campaign.Recipients.Any())
            {
                <a asp-page="/Marketing/Preview"
                   asp-route-campaignId="@Model.Campaign.Id"
                   class="btn btn-outline-primary">
                    <i class="bi bi-eye"></i>
                    Náhled e-mailu
                </a>

                @if (Model.Campaign.Status == "Příprava")
                {
                    <a asp-page="/Marketing/Check"
                       asp-route-id="@Model.Campaign.Id"
                       class="btn btn-outline-success">
                        <i class="bi bi-clipboard-check"></i>
                        Zkontrolovat kampaň
                    </a>
                }
            }

            <a asp-page="/Marketing/Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Zpět na marketingové akce
            </a>

        </div>
    </div>

    <!-- Zprávy -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Základní informace -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>Základní informace</strong>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="text-muted small">Název akce</div>
                    <strong>@Model.Campaign.Name</strong>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">E-mailová šablona</div>
                    <strong>
                        @(Model.Campaign.EmailTemplate?.Name ?? "Nevybrána")
                    </strong>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">Stav</div>

                    @if (Model.Campaign.Status == "Příprava")
                    {
                        <span class="badge bg-secondary">Příprava</span>
                    }
                    else if (Model.Campaign.Status == "Připraveno k odeslání")
                    {
                        <span class="badge bg-primary">
                            Připraveno k odeslání
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-info">
                            @Model.Campaign.Status
                        </span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Campaign.Description))
                {
                    <div class="col-12">
                        <div class="text-muted small">Popis</div>
                        @Model.Campaign.Description
                    </div>
                }

            </div>

        </div>
    </div>

    <!-- Simulace odeslání -->
    @if (Model.Campaign.Status == "Připraveno k odeslání")
    {
        <div class="card border-primary mb-4">

            <div class="card-header bg-primary text-white">
                <strong>
                    <i class="bi bi-send"></i>
                    Odeslání marketingové akce
                </strong>
            </div>

            <div class="card-body">

                <p>
                    Kampaň je připravena k odeslání.
                    Následující operace pouze simuluje odeslání –
                    žádné skutečné e-maily nebudou odeslány.
                </p>

                <p class="text-muted">
                    Všichni dosud neodeslaní příjemci budou označeni jako
                    úspěšně odeslaní. Příjemci, kteří již mají stav
                    <strong>Odesláno</strong>, zůstanou beze změny.
                </p>

                <div class="d-flex gap-2 flex-wrap">

                    <form method="post"
                          asp-page-handler="SimulateSend"
                          onsubmit="return confirm('Opravdu chcete spustit simulaci odeslání? Všichni dosud neodeslaní příjemci budou označeni jako Odesláno. Žádné skutečné e-maily nebudou odeslány.');">

                        <input type="hidden" name="id"
                               value="@Model.Campaign.Id" />

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-send-check"></i>
                            Simulovat odeslání
                        </button>

                    </form>

                    <form method="post"
                          asp-page-handler="ReturnToPreparation"
                          onsubmit="return confirm('Opravdu chcete vrátit kampaň do přípravy?');">

                        <input type="hidden" name="id"
                               value="@Model.Campaign.Id" />

                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Vrátit do přípravy
                        </button>

                    </form>

                </div>

            </div>
        </div>
    }

    @if (Model.Campaign.Status == "Příprava")
    {
        <!-- Úprava marketingové akce -->
        <div class="card mb-4">

            <div class="card-header">
                <strong>Upravit marketingovou akci</strong>
            </div>

            <div class="card-body">

                <form method="post" asp-page-handler="EditCampaign">

                    <input type="hidden" name="id"
                           value="@Model.Campaign.Id" />

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">Název akce</label>
                            <input type="text"
                                   name="name"
                                   class="form-control"
                                   maxlength="150"
                                   value="@Model.Campaign.Name"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">E-mailová šablona</label>

                            <select name="emailTemplateId"
                                    class="form-select">

                                <option value="">-- Nevybráno --</option>

                                @foreach (var template in Model.EmailTemplates)
                                {
                                    <option value="@template.Id"
                                            selected="@(Model.Campaign.EmailTemplateId == template.Id)">
                                        @template.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Popis</label>
                            <input type="text"
                                   name="description"
                                   class="form-control"
                                   maxlength="1000"
                                   value="@Model.Campaign.Description" />
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i>
                                Uložit změny
                            </button>
                        </div>

                    </div>

                </form>

            </div>
        </div>

        <!-- Hromadný výběr příjemců -->
        <div class="card mb-4">

            <div class="card-header">
                <strong>Výběr příjemců</strong>
            </div>

            <div class="card-body">

                <form method="post"
                      asp-page-handler="AddRecipients"
                      id="recipientsForm">

                    <input type="hidden" name="id"
                           value="@Model.Campaign.Id" />

                    <!-- Filtry -->
                    <div class="row g-3 mb-3">

                        <div class="col-md-6">
                            <label class="form-label">Vyhledávání</label>
                            <input type="text"
                                   id="recipientSearch"
                                   class="form-control"
                                   placeholder="Firma, jméno nebo e-mail..." />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Filtrovat podle firmy</label>

                            <select id="recipientCompanyFilter"
                                    class="form-select">

                                <option value="">Všechny firmy</option>

                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.Id">
                                        @company.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button"
                                    id="clearRecipientFilters"
                                    class="btn btn-outline-secondary w-100">
                                Vymazat filtr
                            </button>
                        </div>

                    </div>

                    <!-- Označení všech -->
                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <div>
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   id="selectAllRecipients" />

                            <label for="selectAllRecipients">
                                Označit všechny zobrazené
                            </label>
                        </div>

                        <span class="text-muted small"
                              id="recipientCount">
                        </span>

                    </div>

                    <!-- Tabulka kontaktů -->
                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th style="width: 50px">Výběr</th>
                                    <th>Firma</th>
                                    <th>Kontakt</th>
                                    <th>E-mail</th>
                                    <th>Stav</th>
                                </tr>
                            </thead>

                            <tbody id="recipientTableBody">

                                @foreach (var employment in Model.CurrentEmployments)
                                {
                                    bool alreadyAdded =
                                        Model.Campaign.Recipients.Any(r =>
                                            (r.CompanyId == employment.CompanyId &&
                                             r.ContactId == employment.ContactId)
                                            ||
                                            string.Equals(
                                                r.EmailAddress?.Trim(),
                                                employment.Contact.Email?.Trim(),
                                                StringComparison.OrdinalIgnoreCase));

                                    <tr class="recipient-row"
                                        data-company-id="@employment.CompanyId"
                                        data-search="@($"{employment.Company.Name} {employment.Contact.FirstName} {employment.Contact.LastName} {employment.Contact.Email}".ToLowerInvariant())">

                                        <td>
                                            <input type="checkbox"
                                                   class="form-check-input recipient-checkbox"
                                                   name="SelectedEmploymentIds"
                                                   value="@employment.Id"
                                                   disabled="@alreadyAdded" />
                                        </td>

                                        <td>
                                            @employment.Company.Name
                                        </td>

                                        <td>
                                            @employment.Contact.FirstName
                                            @employment.Contact.LastName
                                        </td>

                                        <td>
                                            @employment.Contact.Email
                                        </td>

                                        <td>
                                            @if (alreadyAdded)
                                            {
                                                <span class="badge bg-secondary">
                                                    Již přidán
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    Lze přidat
                                                </span>
                                            }
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <!-- Akce -->
                    <div class="d-flex justify-content-between align-items-center mt-3">

                        <small class="text-muted">
                            Vyberte kontakty, které chcete přidat do marketingové akce.
                        </small>

                        <button type="submit"
                                class="btn btn-primary"
                                id="addSelectedRecipients">

                            <i class="bi bi-plus-circle"></i>
                            Přidat vybrané kontakty

                        </button>

                    </div>

                </form>

            </div>
        </div>
    }

    <!-- Seznam příjemců kampaně -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>Seznam příjemců</strong>

            <span class="badge bg-primary">
                @Model.Campaign.Recipients.Count příjemců
            </span>

        </div>

        <div class="card-body">

            @if (Model.Campaign.Recipients.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Firma</th>
                                <th>Kontakt</th>
                                <th>E-mail</th>
                                <th>Stav</th>

                                @if (Model.Campaign.Status == "Příprava")
                                {
                                    <th class="text-end">Akce</th>
                                }
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var recipient in Model.Campaign.Recipients
                                .OrderBy(r => r.Company.Name)
                                .ThenBy(r => r.Contact.LastName))
                            {
                                <tr>

                                    <td>
                                        @recipient.Company.Name
                                    </td>

                                    <td>
                                        @recipient.Contact.FirstName
                                        @recipient.Contact.LastName
                                    </td>

                                    <td>
                                        @recipient.EmailAddress
                                    </td>

                                    <td>

                                        @if (recipient.Status == "Připraveno")
                                        {
                                            <span class="badge bg-secondary">
                                                Připraveno
                                            </span>
                                        }
                                        else if (recipient.Status == "Odesláno")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i>
                                                Odesláno
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @recipient.Status
                                            </span>
                                        }

                                    </td>

                                    @if (Model.Campaign.Status == "Příprava")
                                    {
                                        <td class="text-end">

                                            @if (recipient.Status == "Odesláno")
                                            {
                                                <span class="text-muted small">
                                                    <i class="bi bi-lock"></i>
                                                    Historie zachována
                                                </span>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      asp-page-handler="RemoveRecipient"
                                                      class="d-inline">

                                                    <input type="hidden" name="id"
                                                           value="@Model.Campaign.Id" />

                                                    <input type="hidden" name="recipientId"
                                                           value="@recipient.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Opravdu odebrat tohoto příjemce?');">

                                                        <i class="bi bi-trash"></i>
                                                        Odebrat

                                                    </button>

                                                </form>
                                            }

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Zatím nebyli vybráni žádní příjemci.
                </p>
            }

        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("recipientSearch");

            const companyFilter =
                document.getElementById("recipientCompanyFilter");

            const selectAll =
                document.getElementById("selectAllRecipients");

            const clearFilters =
                document.getElementById("clearRecipientFilters");

            const recipientCount =
                document.getElementById("recipientCount");

            const rows =
                Array.from(document.querySelectorAll(".recipient-row"));

            // Pokud stránka není v režimu Příprava,
            // tabulka pro výběr příjemců není zobrazena.
            if (!searchInput || !companyFilter ||
                !selectAll || !clearFilters || !recipientCount) {
                return;
            }

            function updateSelectAllState() {

                const visibleCheckboxes = rows
                    .filter(row => row.style.display !== "none")
                    .map(row => row.querySelector(".recipient-checkbox"))
                    .filter(cb => cb && !cb.disabled);

                const checkedCount =
                    visibleCheckboxes.filter(cb => cb.checked).length;

                selectAll.checked =
                    visibleCheckboxes.length > 0 &&
                    checkedCount === visibleCheckboxes.length;

                selectAll.indeterminate =
                    checkedCount > 0 &&
                    checkedCount < visibleCheckboxes.length;
            }

            function updateTable() {

                const search =
                    searchInput.value.toLowerCase().trim();

                const companyId =
                    companyFilter.value;

                let visibleCount = 0;

                rows.forEach(function (row) {

                    const matchesSearch =
                        row.dataset.search.includes(search);

                    const matchesCompany =
                        !companyId ||
                        row.dataset.companyId === companyId;

                    const visible =
                        matchesSearch && matchesCompany;

                    row.style.display = visible ? "" : "none";

                    if (visible)
                        visibleCount++;

                });

                recipientCount.textContent =
                    "Zobrazeno " + visibleCount + " kontaktů";

                updateSelectAllState();
            }

            searchInput.addEventListener("input", updateTable);

            companyFilter.addEventListener("change", updateTable);

            clearFilters.addEventListener("click", function () {

                searchInput.value = "";
                companyFilter.value = "";

                updateTable();

            });

            selectAll.addEventListener("change", function () {

                rows.forEach(function (row) {

                    if (row.style.display === "none")
                        return;

                    const checkbox =
                        row.querySelector(".recipient-checkbox");

                    if (checkbox && !checkbox.disabled)
                        checkbox.checked = selectAll.checked;

                });

                updateSelectAllState();

            });

            document.querySelectorAll(".recipient-checkbox")
                .forEach(function (checkbox) {

                    checkbox.addEventListener(
                        "change",
                        updateSelectAllState
                    );

                });

            updateTable();

            const recipientsForm =
                document.getElementById("recipientsForm");

            if (recipientsForm) {

                recipientsForm.addEventListener("submit", function (event) {

                    const selected = document.querySelectorAll(
                        ".recipient-checkbox:checked"
                    ).length;

                    if (selected === 0) {

                        event.preventDefault();

                        alert("Nejdříve vyberte alespoň jeden kontakt.");

                        return;
                    }

                    if (!confirm(
                        "Opravdu chcete přidat " +
                        selected +
                        " vybraných kontaktů?"
                    )) {
                        event.preventDefault();
                    }

                });

            }

        });
    </script>

}
