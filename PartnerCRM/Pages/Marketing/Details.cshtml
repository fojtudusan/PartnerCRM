
@page
@model PartnerCRM.Pages.Marketing.DetailsModel

@{
    ViewData["Title"] = "Detail marketingové akce";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@Model.Campaign.Name</h2>
            <p class="text-muted mb-0">
                Detail marketingové akce
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (Model.Campaign.EmailTemplate != null &&
                 Model.Campaign.Recipients.Any())
            {
                <a asp-page="/Marketing/Preview"
                   asp-route-campaignId="@Model.Campaign.Id"
                   class="btn btn-outline-primary">
                    <i class="bi bi-eye"></i>
                    Náhled e-mailu
                </a>
                @if (Model.Campaign.Status == "Příprava")
                    {
                        <a asp-page="/Marketing/Check"
                           asp-route-id="@Model.Campaign.Id"
                           class="btn btn-outline-success">
                            <i class="bi bi-clipboard-check"></i>
                            Zkontrolovat kampaň
                        </a>
                    }
            }

            <a asp-page="/Marketing/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Zpět na marketingové akce
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Základní informace -->
    <div class="card mb-4">
        <div class="card-header">
            <strong>Základní informace</strong>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-4">
                    <div class="text-muted small">Název akce</div>
                    <strong>@Model.Campaign.Name</strong>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">E-mailová šablona</div>
                    <strong>
                        @(Model.Campaign.EmailTemplate?.Name ?? "Nevybrána")
                    </strong>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">Stav</div>
                    @if (Model.Campaign.Status == "Příprava")
                    {
                        <span class="badge bg-secondary">Příprava</span>
                    }
                    else
                    {
                        <span class="badge bg-info">@Model.Campaign.Status</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Campaign.Description))
                {
                    <div class="col-12">
                        <div class="text-muted small">Popis</div>
                        @Model.Campaign.Description
                    </div>
                }

            </div>
        </div>
    </div>

    @if (Model.Campaign.Status == "Příprava")
    {
        <!-- Úprava marketingové akce -->
        <div class="card mb-4">
            <div class="card-header">
                <strong>Upravit marketingovou akci</strong>
            </div>

            <div class="card-body">
                <form method="post" asp-page-handler="EditCampaign">

                    <input type="hidden" name="id"
                           value="@Model.Campaign.Id" />

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label">Název akce</label>
                            <input type="text"
                                   name="name"
                                   class="form-control"
                                   maxlength="150"
                                   value="@Model.Campaign.Name"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">E-mailová šablona</label>

                            <select name="emailTemplateId"
                                    class="form-select">

                                <option value="">-- Nevybráno --</option>

                                @foreach (var template in Model.EmailTemplates)
                                {
                                    <option value="@template.Id"
                                            selected="@(Model.Campaign.EmailTemplateId == template.Id)">
                                        @template.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Popis</label>
                            <input type="text"
                                   name="description"
                                   class="form-control"
                                   maxlength="1000"
                                   value="@Model.Campaign.Description" />
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i>
                                Uložit změny
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>

        <!-- Výběr příjemce -->
        <div class="card mb-4">
            <div class="card-header">
                <strong>Přidat příjemce</strong>
            </div>

            <div class="card-body">

                <form method="post" asp-page-handler="AddRecipient">

                    <input type="hidden" name="id"
                           value="@Model.Campaign.Id" />

                    <div class="row g-3">

                        <div class="col-md-5">
                            <label class="form-label">Firma</label>

                            <select id="companySelect"
                                    name="companyId"
                                    class="form-select"
                                    required>
                                <option value="">-- Vyberte firmu --</option>

                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.Id">
                                        @company.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Kontakt</label>

                            <select id="contactSelect"
                                    name="contactId"
                                    class="form-select"
                                    required
                                    disabled>
                                <option value="">-- Nejprve vyberte firmu --</option>

                                @foreach (var employment in Model.CurrentEmployments)
                                {
                                    <option value="@employment.ContactId"
                                            data-company-id="@employment.CompanyId">
                                        @employment.Contact.FirstName
                                        @employment.Contact.LastName
                                        (@employment.Contact.Email)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    id="addRecipientButton"
                                    disabled>
                                <i class="bi bi-plus-circle"></i>
                                Přidat
                            </button>
                        </div>

                    </div>

                    <small class="text-muted d-block mt-2">
                        Nejprve vyberte firmu. Následně se zobrazí její aktuální kontakty s e-mailovou adresou.
                    </small>

                </form>
            </div>
        </div>
    }

    <!-- Seznam příjemců -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Seznam příjemců</strong>

            <span class="badge bg-primary">
                @Model.Campaign.Recipients.Count příjemců
            </span>
        </div>

        <div class="card-body">

            @if (Model.Campaign.Recipients.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Firma</th>
                                <th>Kontakt</th>
                                <th>E-mail</th>
                                <th>Stav</th>

                                @if (Model.Campaign.Status == "Příprava")
                                {
                                    <th class="text-end">Akce</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var recipient in Model.Campaign.Recipients
                                .OrderBy(r => r.Company.Name)
                                .ThenBy(r => r.Contact.LastName))
                            {
                                <tr>
                                    <td>@recipient.Company.Name</td>

                                    <td>
                                        @recipient.Contact.FirstName
                                        @recipient.Contact.LastName
                                    </td>

                                    <td>@recipient.EmailAddress</td>

                                    <td>
                                        @if (recipient.Status == "Připraveno")
                                        {
                                            <span class="badge bg-secondary">
                                                Připraveno
                                            </span>
                                        }
                                        else if (recipient.Status == "Odesláno")
                                        {
                                            <span class="badge bg-success">
                                                Odesláno
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @recipient.Status
                                            </span>
                                        }
                                    </td>

                                    @if (Model.Campaign.Status == "Příprava")
                                    {
                                        <td class="text-end">
                                            <form method="post"
                                                  asp-page-handler="RemoveRecipient"
                                                  class="d-inline">

                                                <input type="hidden" name="id"
                                                       value="@Model.Campaign.Id" />

                                                <input type="hidden" name="recipientId"
                                                       value="@recipient.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Opravdu odebrat tohoto příjemce?');">
                                                    <i class="bi bi-trash"></i>
                                                    Odebrat
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Zatím nebyli vybráni žádní příjemci.
                </p>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const companySelect = document.getElementById("companySelect");
            const contactSelect = document.getElementById("contactSelect");
            const addButton = document.getElementById("addRecipientButton");

            if (!companySelect || !contactSelect || !addButton)
                return;

            const contactOptions = Array.from(contactSelect.options)
                .slice(1);

            function updateContacts() {

                const companyId = companySelect.value;

                contactSelect.innerHTML = "";

                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = companyId
                    ? "-- Vyberte kontakt --"
                    : "-- Nejprve vyberte firmu --";

                contactSelect.appendChild(placeholder);

                let count = 0;

                contactOptions.forEach(function (option) {

                    if (option.dataset.companyId === companyId && companyId) {

                        const newOption = option.cloneNode(true);
                        contactSelect.appendChild(newOption);
                        count++;
                    }
                });

                contactSelect.disabled = !companyId || count === 0;

                if (companyId && count === 0) {
                    placeholder.textContent =
                        "-- Firma nemá kontakty s e-mailem --";
                }

                addButton.disabled = true;
            }

            companySelect.addEventListener("change", updateContacts);

            contactSelect.addEventListener("change", function () {
                addButton.disabled = !contactSelect.value;
            });

        });
    </script>
}
