
@page
@model PartnerCRM.Pages.Marketing.PreviewModel

@{
    ViewData["Title"] = "Náhled e-mailu";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-envelope-open"></i> Náhled e-mailu</h2>
            <div class="text-muted">
                Marketingová akce: @Model.CampaignName
            </div>
        </div>

        <a asp-page="/Marketing/Details"
           asp-route-id="@Model.CampaignName"
           class="btn btn-outline-secondary"
           onclick="history.back(); return false;">
            <i class="bi bi-arrow-left"></i> Zpět
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Informace o příjemci</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-2">
                    <strong>Firma:</strong> @Model.CompanyName
                </div>
                <div class="col-md-6 mb-2">
                    <strong>Kontakt:</strong> @Model.RecipientName
                </div>
                <div class="col-md-6">
                    <strong>E-mail:</strong> @Model.RecipientEmail
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Obsah e-mailu</strong>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Předmět</label>
                <div class="form-control bg-light">
                    @Model.Subject
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label fw-bold">Text zprávy</label>
                <div class="border rounded p-3 bg-white"
                     style="white-space: pre-wrap; min-height: 250px;">@Model.Body</div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle"></i>
        Toto je pouze náhled. Žádný e-mail nebyl odeslán.
    </div>

</div>
