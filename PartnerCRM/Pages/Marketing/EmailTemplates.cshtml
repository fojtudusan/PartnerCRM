
@page
@model PartnerCRM.Pages.Marketing.EmailTemplatesModel

@{
    ViewData["Title"] = "E-mailové šablony";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>E-mailové šablony</h2>
            <p class="text-muted mb-0">
                Správa připravených e-mailů pro marketingové akce.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Přidání nové šablony -->
    <div class="card mb-4">
        <div class="card-header">
            <strong>Nová e-mailová šablona</strong>
        </div>

        <div class="card-body">
            <form method="post" asp-page-handler="Add">

                <div class="mb-3">
                    <label class="form-label">Interní název šablony</label>
                    <input asp-for="NewName"
                           class="form-control"
                           maxlength="150"
                           placeholder="Např. GEORGE – představení robota"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Předmět e-mailu</label>
                    <input asp-for="NewSubject"
                           class="form-control"
                           maxlength="250"
                           placeholder="Předmět zprávy"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Text e-mailu</label>
                    <textarea asp-for="NewBody"
                              class="form-control"
                              rows="10"
                              placeholder="Text e-mailové zprávy..."
                              required></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Přidat šablonu
                </button>
            </form>
        </div>
    </div>

    <!-- Seznam šablon -->
    <div class="card">
        <div class="card-header">
            <strong>Seznam e-mailových šablon</strong>
        </div>

        <div class="card-body">

            @if (Model.EmailTemplates.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Název</th>
                                <th>Předmět</th>
                                <th>Vytvořeno</th>
                                <th>Stav</th>
                                <th class="text-end">Akce</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var template in Model.EmailTemplates)
                            {
                                <tr>
                                    <td>
                                        <strong>@template.Name</strong>
                                    </td>

                                    <td>@template.Subject</td>

                                    <td>
                                        @template.CreatedAt.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>
                                        @if (template.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktivní
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Neaktivní
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editModal"
                                                data-id="@template.Id"
                                                data-name="@template.Name"
                                                data-subject="@template.Subject"
                                                data-body="@template.Body">
                                            Upravit
                                        </button>

                                        <form method="post"
                                              asp-page-handler="ToggleActive"
                                              asp-route-id="@template.Id"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">
                                                @(template.IsActive
                                                    ? "Deaktivovat"
                                                    : "Aktivovat")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Zatím nebyla vytvořena žádná e-mailová šablona.
                </p>
            }
        </div>
    </div>
</div>

<!-- Okno pro úpravu šablony -->
<div class="modal fade" id="editModal" tabindex="-1"
     aria-labelledby="editModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form method="post" asp-page-handler="Edit">

                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">
                        Upravit e-mailovou šablonu
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="id" id="editId" />

                    <div class="mb-3">
                        <label class="form-label">Interní název</label>
                        <input type="text"
                               name="name"
                               id="editName"
                               class="form-control"
                               maxlength="150"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Předmět e-mailu</label>
                        <input type="text"
                               name="subject"
                               id="editSubject"
                               class="form-control"
                               maxlength="250"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Text e-mailu</label>
                        <textarea name="body"
                                  id="editBody"
                                  class="form-control"
                                  rows="12"
                                  required></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Zrušit
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Uložit změny
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const editModal = document.getElementById("editModal");

            editModal.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                document.getElementById("editId").value =
                    button.getAttribute("data-id");

                document.getElementById("editName").value =
                    button.getAttribute("data-name");

                document.getElementById("editSubject").value =
                    button.getAttribute("data-subject");

                document.getElementById("editBody").value =
                    button.getAttribute("data-body");
            });
        });
    </script>
}
