
@page
@model PartnerCRM.Pages.Tasks.IndexModel

@{
    ViewData["Title"] = "Úkoly";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Úkoly</h2>
        <p class="text-muted mb-0">
            Přehled obchodních a pracovních úkolů
        </p>
    </div>

    <a asp-page="./Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Nový úkol
    </a>
</div>

<!-- FILTRY -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <strong>
            <i class="bi bi-funnel"></i>
            Filtrování úkolů
        </strong>
    </div>

    <div class="card-body">
        <form method="get">
            <div class="row g-3">

                <div class="col-md-3">
                    <label asp-for="StatusFilter" class="form-label">
                        Stav
                    </label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="">Všechny stavy</option>
                        <option value="Nový">Nový</option>
                        <option value="Probíhá">Probíhá</option>
                        <option value="Splněno">Splněno</option>
                        <option value="Zrušeno">Zrušeno</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="PriorityFilter" class="form-label">
                        Priorita
                    </label>
                    <select asp-for="PriorityFilter" class="form-select">
                        <option value="">Všechny priority</option>
                        <option value="Nízká">Nízká</option>
                        <option value="Normální">Normální</option>
                        <option value="Vysoká">Vysoká</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="CompanyFilter" class="form-label">
                        Firma
                    </label>
                    <select asp-for="CompanyFilter"
                            asp-items="Model.CompaniesList"
                            class="form-select">
                        <option value="">Všechny firmy</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="DueDateFrom" class="form-label">
                        Termín od
                    </label>
                    <input asp-for="DueDateFrom"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="DueDateTo" class="form-label">
                        Termín do
                    </label>
                    <input asp-for="DueDateTo"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-6 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        Filtrovat
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                        Vymazat filtry
                    </a>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">
        Počet nalezených úkolů: <strong>@Model.Tasks.Count</strong>
    </span>
</div>

<div class="card">
    <div class="card-body p-0">

        @if (Model.Tasks.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Termín</th>
                        <th>Úkol</th>
                        <th>Firma</th>
                        <th>Kontaktní osoba</th>
                        <th>Priorita</th>
                        <th>Stav</th>
                        <th>Akce</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var task in Model.Tasks)
                    {
                        var priorityClass = task.Priority switch
                        {
                            "Vysoká" => "bg-danger",
                            "Nízká" => "bg-secondary",
                            _ => "bg-primary"
                        };

                        var statusClass = task.Status switch
                        {
                            "Nový" => "bg-info text-dark",
                            "Probíhá" => "bg-warning text-dark",
                            "Splněno" => "bg-success",
                            "Zrušeno" => "bg-secondary",
                            _ => "bg-light text-dark"
                        };

                        var today = DateTime.Today;

                        var dueClass = task.Status == "Splněno"
                            ? "text-success"
                            : task.Status == "Zrušeno"
                                ? "text-muted"
                                : task.DueDate.Date < today
                                    ? "text-danger fw-bold"
                                    : task.DueDate.Date == today
                                        ? "text-warning fw-bold"
                                        : task.DueDate.Date <= today.AddDays(3)
                                            ? "text-warning"
                                            : "";

                        <tr>
                            <td>
                                <span class="fw-bold @dueClass">
                                    @task.DueDate.ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </td>

                            <td>
                                <a asp-page="./Details"
                                   asp-route-id="@task.Id"
                                   class="text-decoration-none fw-bold">
                                    @task.Title
                                </a>

                                @if (task.ParentTaskId.HasValue)
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-arrow-return-right"></i> Podúkol
                                    </div>
                                }
                                else if (task.ChildTasks.Any())
                                {
                                    <div class="small text-muted">
                                        <i class="bi bi-diagram-3"></i>
                                        Podúkoly: @task.ChildTasks.Count
                                    </div>
                                }
                            </td>

                            <td>
                                @(task.Company?.Name ?? "—")
                            </td>

                            <td>
                                @if (task.Contact != null)
                                {
                                    @task.Contact.FirstName
                                    @:
                                    @task.Contact.LastName
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                <span class="badge @priorityClass">
                                    @task.Priority
                                </span>
                            </td>

                            <td>
                                <span class="badge @statusClass">
                                    @task.Status
                                </span>
                            </td>

                            <td class="text-nowrap">
                                <a asp-page="./Edit"
                                   asp-route-id="@task.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Upravit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@task.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Smazat">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-4 text-muted">
                Žádné úkoly neodpovídají zadaným filtrům.
            </div>
        }

    </div>
</div>
