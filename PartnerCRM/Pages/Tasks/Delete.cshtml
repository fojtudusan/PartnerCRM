
@page "{id:int}"
@model PartnerCRM.Pages.Tasks.DeleteModel

@{
    ViewData["Title"] = "Smazat úkol";
}

<div class="mb-4">
    <h2>Smazat úkol</h2>

    @if (Model.CanDelete)
    {
        <p class="text-muted mb-0">
            Opravdu chcete tento úkol odstranit?
        </p>
    }
    else
    {
        <p class="text-muted mb-0">
            Tento úkol nelze bezpečně odstranit.
        </p>
    }
</div>

<div class="card">
    <div class="card-body">

        <h5>@Model.TaskItem.Title</h5>

        <dl class="row mt-3">
            <dt class="col-sm-3">Termín</dt>
            <dd class="col-sm-9">
                @Model.TaskItem.DueDate.ToString("dd.MM.yyyy HH:mm")
            </dd>

            <dt class="col-sm-3">Firma</dt>
            <dd class="col-sm-9">
                @(Model.TaskItem.Company?.Name ?? "—")
            </dd>

            <dt class="col-sm-3">Priorita</dt>
            <dd class="col-sm-9">@Model.TaskItem.Priority</dd>

            <dt class="col-sm-3">Stav</dt>
            <dd class="col-sm-9">@Model.TaskItem.Status</dd>
        </dl>

        @if (!Model.CanDelete)
        {
            <div class="alert alert-warning mt-3">
                <h6>
                    <i class="bi bi-exclamation-triangle"></i>
                    Mazání není povoleno
                </h6>

                <ul class="mb-0">
                    @foreach (var restriction in Model.DeleteRestrictions)
                    {
                        <li>@restriction</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">
                Úkol nemá žádné podúkoly ani související aktivity.
                Můžete jej bezpečně odstranit.
            </div>
        }

        <form method="post">
            <input type="hidden" name="id" value="@Model.TaskItem.Id" />

            @if (Model.CanDelete)
            {
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Ano, smazat
                </button>
            }

            <a asp-page="./Index"
               class="btn btn-outline-secondary">
                @(Model.CanDelete ? "Zrušit" : "Zpět na úkoly")
            </a>
        </form>

    </div>
</div>
