
@page "{id:int}"
@model PartnerCRM.Pages.Contacts.DeleteModel

@{
    ViewData["Title"] = "Zneplatnění kontaktu";
}

<div class="mb-4">
    <h2 class="mb-1">Zneplatnění kontaktu</h2>
    <p class="text-muted mb-0">
        Kontakt bude označen jako neaktivní. Jeho historie zůstane zachována.
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <dl class="row mb-4">

            <dt class="col-sm-3">Jméno</dt>
            <dd class="col-sm-9">
                @Model.Contact.FirstName @Model.Contact.LastName
            </dd>

            <dt class="col-sm-3">Firma</dt>
            <dd class="col-sm-9">
                @Model.Contact.Company?.Name
            </dd>

            <dt class="col-sm-3">Pozice</dt>
            <dd class="col-sm-9">
                @Model.Contact.Position
            </dd>

            <dt class="col-sm-3">E-mail</dt>
            <dd class="col-sm-9">
                @Model.Contact.Email
            </dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">
                @Model.Contact.Phone
            </dd>

        </dl>

        <hr />

        <h5 class="mb-3">Historie kontaktu</h5>

        <div class="row mb-4">

            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted small">Působení ve firmách</div>
                    <div class="fs-4 fw-semibold">
                        @Model.EmploymentCount
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted small">Aktivity</div>
                    <div class="fs-4 fw-semibold">
                        @Model.ActivityCount
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="border rounded p-3 h-100">
                    <div class="text-muted small">Úkoly</div>
                    <div class="fs-4 fw-semibold">
                        @Model.TaskCount
                    </div>
                </div>
            </div>

        </div>

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Opravdu chcete zneplatnit tento kontakt?</strong>

            <p class="mb-0 mt-2">
                Kontakt nebude odstraněn z databáze. Zachováme jeho
                osobní údaje, fotografii, poznámky, působení ve firmách,
                aktivity i úkoly. Kontakt bude pouze označen jako neaktivní.
            </p>
        </div>

        <form method="post">

            <div class="d-flex justify-content-end gap-2">

                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    Zpět
                </a>

                <button type="submit"
                        class="btn btn-warning">
                    <i class="bi bi-person-x"></i>
                    Zneplatnit kontakt
                </button>

            </div>

        </form>

    </div>
</div>
