@page "{id:int}"
@model PartnerCRM.Pages.Contacts.EditModel

@{
    ViewData["Title"] = "Úprava kontaktu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Úprava kontaktu</h2>
        <p class="text-muted mb-0">
            Změna údajů kontaktní osoby.
        </p>
    </div>

    <a asp-page="./Employments"
       asp-route-id="@Model.Contact.Id"
       class="btn btn-outline-primary">
        <i class="bi bi-building"></i>
        Spravovat firmy a působení
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form method="post">

            <input type="hidden" asp-for="Contact.Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>
            
@if (Model.EmailDuplicateWarning && Model.EmailMatch != null)
{
    <div class="alert alert-warning mb-3">

        <strong>Pozor! Tento e-mail již evidujeme u jiného kontaktu.</strong>

        <p class="mb-2 mt-2">
            <strong>
                @Model.EmailMatch.FirstName
                @Model.EmailMatch.LastName
            </strong>
        </p>

        <p class="mb-2">
            Firma: @Model.EmailMatch.CompanyName
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.EmailMatch.Position))
        {
            <p class="mb-2">
                Pozice: @Model.EmailMatch.Position
            </p>
        }

        <a asp-page="./Edit"
           asp-route-id="@Model.EmailMatch.Id"
           class="btn btn-sm btn-outline-primary mb-3">
            <i class="bi bi-person"></i>
            Otevřít existující kontakt
        </a>

        <hr />

        <div class="form-check">
            <input asp-for="ConfirmEmailDuplicate"
                   class="form-check-input" />

            <label asp-for="ConfirmEmailDuplicate"
                   class="form-check-label">
                Vím o existujícím kontaktu a přesto chci
                tento e-mail použít.
            </label>
        </div>

    </div>
}

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Contact.FirstName"
                           class="form-label">Jméno *</label>
                    <input asp-for="Contact.FirstName"
                           class="form-control" />
                    <span asp-validation-for="Contact.FirstName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Contact.LastName"
                           class="form-label">Příjmení *</label>
                    <input asp-for="Contact.LastName"
                           class="form-control" />
                    <span asp-validation-for="Contact.LastName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Contact.CompanyId"
                           class="form-label">Firma *</label>
                    <select asp-for="Contact.CompanyId"
                            asp-items="Model.CompaniesList"
                            class="form-select">
                        <option value="">-- Vyberte firmu --</option>
                    </select>
                    <span asp-validation-for="Contact.CompanyId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Contact.Position"
                           class="form-label">Pracovní pozice</label>
                    <input asp-for="Contact.Position"
                           class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Contact.Email"
                           class="form-label">E-mail</label>
                    <input asp-for="Contact.Email"
                           class="form-control" />
                    <span asp-validation-for="Contact.Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Contact.Phone"
                           class="form-label">Telefon</label>
                    <input asp-for="Contact.Phone"
                           class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input asp-for="Contact.IsPrimary"
                               class="form-check-input" />
                        <label asp-for="Contact.IsPrimary"
                               class="form-check-label">
                            Hlavní kontaktní osoba firmy
                        </label>
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    Zrušit
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    @(Model.EmailDuplicateWarning
                        ? "Uložit i přesto"
                        : "Uložit změny")
                </button>

            </div>

        </form>

    </div>
</div>