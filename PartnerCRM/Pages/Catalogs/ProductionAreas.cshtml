
@page
@model PartnerCRM.Pages.Catalogs.ProductionAreasModel

@{
    ViewData["Title"] = "Oblasti produkce";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Oblasti produkce</h2>
            <p class="text-muted mb-0">
                Správa oblastí produkce a jejich podkategorií.
            </p>
        </div>

        <a asp-page="/Catalogs/Index" class="btn btn-outline-secondary">
            Zpět na číselníky
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <strong>Přidat oblast produkce</strong>
        </div>

        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Název oblasti</label>
                        <input asp-for="NewName"
                               class="form-control"
                               maxlength="150"
                               required />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Nadřazená oblast</label>
                        <select asp-for="NewParentProductionAreaId"
                                class="form-select">
                            <option value="">-- Hlavní oblast --</option>
                            @foreach (var item in Model.ProductionAreas
                                .Where(a => a.IsActive)
                                .OrderBy(a => a.Name))
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Popis</label>
                        <input asp-for="NewDescription"
                               class="form-control"
                               maxlength="500" />
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            Přidat
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Struktura oblastí produkce</strong>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Oblast produkce</th>
                            <th>Popis</th>
                            <th>Stav</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>
                    
<tbody>
    @foreach (var item in Model.HierarchicalAreas)
    {
        var area = item.Area;

        <tr>
            <td>
                <span style="padding-left: @(item.Depth * 25)px;">
                    @if (item.Depth > 0)
                    {
                        <span class="text-muted">↳ </span>
                    }
                    <strong>@area.Name</strong>
                </span>
            </td>

            <td>@(area.Description ?? "—")</td>

            <td>
                @if (area.IsActive)
                {
                    <span class="badge bg-success">Aktivní</span>
                }
                else
                {
                    <span class="badge bg-secondary">Neaktivní</span>
                }
            </td>

            <td class="text-end text-nowrap">
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#editModal"
                        data-id="@area.Id"
                        data-name="@area.Name"
                        data-description="@area.Description"
                        data-parent-id="@(area.ParentProductionAreaId?.ToString() ?? "")">
                    Upravit
                </button>

                <form method="post"
                      asp-page-handler="ToggleActive"
                      asp-route-id="@area.Id"
                      class="d-inline">
                    <button type="submit"
                            class="btn btn-sm btn-outline-secondary">
                        @(area.IsActive ? "Deaktivovat" : "Aktivovat")
                    </button>
                </form>
            </td>
        </tr>
    }
</tbody>

                </table>
            </div>
        </div>
    </div>
</div>

<!-- Dialog pro úpravu oblasti -->
<div class="modal fade" id="editModal" tabindex="-1"
     aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">
                        Upravit oblast produkce
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="editId" />

                    <div class="mb-3">
                        <label class="form-label">Název</label>
                        <input type="text" name="name" id="editName"
                               class="form-control" maxlength="150" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nadřazená oblast</label>
                        <select name="parentProductionAreaId"
                                id="editParentId" class="form-select">
                            <option value="">-- Hlavní oblast --</option>
                            @foreach (var item in Model.ProductionAreas
                                .OrderBy(a => a.Name))
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Popis</label>
                        <textarea name="description" id="editDescription"
                                  class="form-control" maxlength="500"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Zrušit
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Uložit změny
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editModal = document.getElementById("editModal");

            editModal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;

                document.getElementById("editId").value =
                    button.getAttribute("data-id");

                document.getElementById("editName").value =
                    button.getAttribute("data-name");

                document.getElementById("editDescription").value =
                    button.getAttribute("data-description") || "";

                document.getElementById("editParentId").value =
                    button.getAttribute("data-parent-id") || "";
            });
        });
    </script>
}
