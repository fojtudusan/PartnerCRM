
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var catalogsExpanded =
        currentPage.StartsWith("/Catalogs/") ||
        currentPage == "/Marketing/EmailTemplates";
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PartnerCRM</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PartnerCRM.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>
    <div class="crm-layout">

        <aside class="sidebar">
            <div class="brand">
                <i class="bi bi-diagram-3"></i>
                <span>PartnerCRM</span>
            </div>

            <div class="nav-caption">HLAVNÍ MENU</div>

            <nav class="crm-nav">
                <a asp-page="/Index" class="crm-nav-link">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <a asp-page="/Companies/Index" class="crm-nav-link">
                    <i class="bi bi-building"></i>
                    Firmy
                </a>

                <a asp-page="/Contacts/Index" class="crm-nav-link">
                    <i class="bi bi-people"></i>
                    Kontakty
                </a>

                <a asp-page="/Activities/Index" class="crm-nav-link">
                    <i class="bi bi-telephone"></i>
                    Aktivity
                </a>

                <a asp-page="/Calendar/Index" class="crm-nav-link">
                    <i class="bi bi-calendar3"></i>
                    Kalendář
                </a>

                <a asp-page="/Tasks/Index" class="crm-nav-link">
                    <i class="bi bi-list-check"></i>
                    Úkoly
                </a>

                <a asp-page="/Marketing/Index" class="crm-nav-link">
                    <i class="bi bi-megaphone"></i>
                    Marketingové akce
                </a>

                <a asp-page="/Marketing/Results" class="crm-nav-link">
                    <i class="bi bi-bar-chart-line"></i>
                    Evidence výsledků
                </a>

              <div class="crm-nav-group">
    <button class="crm-nav-link crm-nav-toggle"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#catalogsMenu"
        aria-expanded="@(catalogsExpanded.ToString().ToLower())"
        aria-controls="catalogsMenu">
    <i class="bi bi-card-list"></i>
    <span>Číselníky</span>
    <i class="bi bi-chevron-down ms-auto"></i>
</button>

<div class="collapse @(catalogsExpanded ? "show" : "")" id="catalogsMenu">
        <div class="crm-subnav">

            <a asp-page="/Catalogs/ProductionAreas" class="crm-nav-link">
                <i class="bi bi-diagram-3"></i>
                Oblasti produkce
            </a>

            <a asp-page="/Catalogs/ProductTypes" class="crm-nav-link">
                <i class="bi bi-box-seam"></i>
                Typy zboží
            </a>

            <a asp-page="/Marketing/EmailTemplates" class="crm-nav-link">
                <i class="bi bi-envelope"></i>
                E-mailové šablony
            </a>

        </div>
    </div>
</div>
            </nav>
            @if (User.IsInRole("Admin"))
{
    <div class="crm-nav-group mt-2">
        <div class="nav-caption">ADMINISTRACE</div>

        <a asp-page="/Admin/Users/Index" class="crm-nav-link">
            <i class="bi bi-person-gear"></i>
            Uživatelé
        </a>
    </div>
}
            <div class="sidebar-footer">
                <i class="bi bi-person-circle"></i>
                <span>Uživatel CRM</span>
            </div>
        </aside>

        <div class="main-area">

            <header class="topbar">
                <div class="topbar-title">
                    Obchodní systém
                </div>

                <div class="topbar-right">
                    <span class="system-status">
                        <i class="bi bi-circle-fill"></i>
                        Lokální provoz
                    </span>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="crm-footer">
                PartnerCRM &copy; 2026
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
