
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PartnerCRM</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PartnerCRM.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>
    <div class="crm-layout">

        <aside class="sidebar">
            <div class="brand">
                <i class="bi bi-diagram-3"></i>
                <span>PartnerCRM</span>
            </div>

            <div class="nav-caption">HLAVNÍ MENU</div>

            <nav class="crm-nav">
                <a asp-page="/Index" class="crm-nav-link">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <a asp-page="/Companies/Index" class="crm-nav-link">
                    <i class="bi bi-building"></i>
                    Firmy
                </a>

                <a asp-page="/Contacts/Index" class="crm-nav-link">
                    <i class="bi bi-people"></i>
                    Kontakty
                </a>

                <a asp-page="/Activities/Index" class="crm-nav-link">
                    <i class="bi bi-telephone"></i>
                    Aktivity
                </a>

                <a asp-page="/Calendar/Index" class="crm-nav-link">
                    <i class="bi bi-calendar3"></i>
                    Kalendář
                </a>

                <a asp-page="/Tasks/Index" class="crm-nav-link">
                    <i class="bi bi-list-check"></i>
                    Úkoly
                </a>
                <a asp-page="/Catalogs/Index" class="crm-nav-link">
                    <i class="bi bi-card-list"></i>
                    Číselníky
                </a>
                <a asp-page="/Marketing/Index" class="crm-nav-link">
                    <i class="bi bi-megaphone"></i>
                    Marketingové akce
                </a>

                <a asp-page="/Marketing/EmailTemplates" class="crm-nav-link">
                    <i class="bi bi-envelope"></i>
                    E-mailové šablony
                </a>
                <a asp-page="/Marketing/Results" class="crm-nav-link">
                    <i class="bi bi-bar-chart-line"></i>
                    Evidence výsledků
                </a>
            </nav>

            <div class="sidebar-footer">
                <i class="bi bi-person-circle"></i>
                <span>Uživatel CRM</span>
            </div>
        </aside>

        <div class="main-area">

            <header class="topbar">
                <div class="topbar-title">
                    Obchodní systém
                </div>

                <div class="topbar-right">
                    <span class="system-status">
                        <i class="bi bi-circle-fill"></i>
                        Lokální provoz
                    </span>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>

            <footer class="crm-footer">
                PartnerCRM &copy; 2026
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
