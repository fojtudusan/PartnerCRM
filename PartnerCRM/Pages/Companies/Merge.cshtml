
@page
@model PartnerCRM.Pages.Companies.MergeModel

@{
    ViewData["Title"] = "Sloučení firem";
}

<div class="mb-4">
    <h2 class="mb-1">Sloučení firem</h2>
    <p class="text-muted mb-0">
        Sloučení duplicitních firem a převedení souvisejících záznamů.
    </p>
</div>

<div class="alert alert-warning">
    <strong>Upozornění:</strong>
    Sloučení převede kontakty, aktivity, úkoly a podřízené firmy
    do zachovávané firmy. Druhá firma bude archivována.
    Tuto operaci nelze běžným způsobem vrátit zpět.
</div>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-building me-2"></i>
                Výběr firem
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="mb-4">
                <label asp-for="KeepCompanyId"
                       class="form-label fw-semibold">
                    Firma, která zůstane zachována
                </label>

                <select asp-for="KeepCompanyId"
                        asp-items="Model.KeepCompanies"
                        class="form-select">
                    <option value="">-- Vyberte zachovávanou firmu --</option>
                </select>

                <div class="form-text">
                    Tato firma bude výsledným záznamem.
                    Její název a ID zůstanou zachovány.
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="MergeCompanyId"
                       class="form-label fw-semibold">
                    Firma, která bude sloučena a archivována
                </label>

                <select asp-for="MergeCompanyId"
                        asp-items="Model.MergeCompanies"
                        class="form-select">
                    <option value="">-- Vyberte slučovanou firmu --</option>
                </select>

                <div class="form-text">
                    Její kontakty, aktivity, úkoly a další údaje
                    budou převedeny do zachovávané firmy.
                </div>
            </div>

            <hr />

            <div class="form-check mb-3">
                <input asp-for="ConfirmMerge"
                       class="form-check-input" />

                <label asp-for="ConfirmMerge"
                       class="form-check-label">
                    Zkontroloval jsem výběr firem a souhlasím
                    s provedením sloučení a archivací druhé firmy.
                </label>
            </div>

        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Zrušit
        </a>

        <button type="submit" class="btn btn-warning">
            <i class="bi bi-intersect me-1"></i>
            Sloučit firmy
        </button>

    </div>

</form>
