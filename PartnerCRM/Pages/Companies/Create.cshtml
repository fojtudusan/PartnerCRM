@page
@model PartnerCRM.Pages.Companies.CreateModel

@{
    ViewData["Title"] = "Nová firma";
}

<div class="mb-4">
    <h2 class="mb-1">Nová firma</h2>
    <p class="text-muted mb-0">
        Zadejte základní údaje o společnosti.
    </p>
</div>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    @if (Model.IcoMatch != null)
    {
        <div class="alert alert-danger mb-3">
            <strong>Firma s tímto IČO již existuje!</strong>
            <p class="mb-1">
                @Model.IcoMatch.Name
                (IČO: @Model.IcoMatch.ICO)
            </p>
            <a asp-page="./Details"
               asp-route-id="@Model.IcoMatch.Id"
               class="alert-link">
                Zobrazit existující firmu
            </a>
        </div>
    }

    @if (Model.NameDuplicateWarning && Model.NameMatches.Any())
    {
        <div class="alert alert-warning mb-3">
            <strong>Pozor, podobná firma již existuje!</strong>

            <p class="mb-2">
                V databázi jsme našli firmu se stejným názvem:
            </p>

            <ul class="mb-2">
                @foreach (var match in Model.NameMatches)
                {
                    <li>
                        <a asp-page="./Details"
                           asp-route-id="@match.Id">
                            @match.Name
                        </a>
                        @if (!string.IsNullOrWhiteSpace(match.ICO))
                        {
                            <span>(IČO: @match.ICO)</span>
                        }
                    </li>
                }
            </ul>

            <p class="mb-0">
                Pokud jde skutečně o jinou společnost,
                můžete pokračovat v zakládání.
            </p>
        </div>

        <input type="hidden"
               asp-for="ConfirmNameDuplicate"
                />
    }


    <!-- ZÁKLADNÍ ÚDAJE -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-building me-2"></i>
                Základní údaje
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row">

                <div class="col-md-8 mb-3">
                    <label asp-for="Company.Name"
                           class="form-label">
                        Název firmy *
                    </label>
                    <input asp-for="Company.Name"
                           class="form-control"
                           placeholder="Např. ABC s.r.o."
                           autocomplete="off" />

                    <div id="companyNameResults"
                         class="list-group shadow-sm mt-1"
                         style="display:none;">
                    </div>

                    <span asp-validation-for="Company.Name"
                          class="text-danger"></span>
                </div>

                <div class="col-md-8 mb-3">
                    <label asp-for="Company.ParentCompanyId"
                           class="form-label">
                        Nadřazená firma / centrála
                    </label>

                    <select asp-for="Company.ParentCompanyId"
                            asp-items="Model.ParentCompanies"
                            class="form-select">
                        <option value="">-- Samostatná firma / centrála --</option>
                    </select>

                    <div class="form-text">
                        Pokud jde o pobočku, vyberte její nadřazenou firmu.
                        Jinak ponechte pole prázdné.
                    </div>

                    <span asp-validation-for="Company.ParentCompanyId"
                          class="text-danger"></span>
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label fw-semibold">
                        Typ firmy
                    </label>

                    <div class="row">
                        @foreach (var type in Model.CompanyTypes)
                        {
                            <div class="col-md-4 col-sm-6 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedCompanyTypeIds"
                                           value="@type.Id"
                                           id="companyType_@type.Id"
                                           checked="@(Model.SelectedCompanyTypeIds.Contains(type.Id) ? "checked" : null)" />

                                    <label class="form-check-label"
                                           for="companyType_@type.Id">
                                        @type.Name
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <span asp-validation-for="SelectedCompanyTypeIds"
                          class="text-danger"></span>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="Company.ICO"
                           class="form-label">IČO</label>

                    <div class="input-group">
                        <input asp-for="Company.ICO"
                               class="form-control"
                               placeholder="12345678"
                               autocomplete="off" />

                        <button type="button"
                                id="loadAresButton"
                                class="btn btn-outline-primary">
                            <i class="bi bi-cloud-download"></i>
                            Načíst z ARES
                        </button>
                    </div>

                    <span asp-validation-for="Company.ICO"
                          class="text-danger"></span>

                    <div id="aresMessage" class="small mt-2"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Company.DIC"
                           class="form-label">DIČ</label>
                    <input asp-for="Company.DIC"
                           class="form-control"
                           placeholder="CZ12345678" />
                </div>

            </div>
        </div>
    </div>

    

    <!-- KONTAKTNÍ ÚDAJE -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-telephone me-2"></i>
                Kontaktní údaje
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.Phone"
                           class="form-label">Hlavní telefon</label>
                    <input asp-for="Company.Phone"
                           class="form-control"
                           placeholder="+420 ..." />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.Fax"
                           class="form-label">Hlavní fax</label>
                    <input asp-for="Company.Fax"
                           class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.Email"
                           class="form-label">E-mailová adresa</label>
                    <input asp-for="Company.Email"
                           class="form-control"
                           placeholder="info@firma.cz" />
                    <span asp-validation-for="Company.Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.Website"
                           class="form-label">Webové stránky</label>
                    <input asp-for="Company.Website"
                           class="form-control"
                           placeholder="www.firma.cz" />
                </div>

            </div>
        </div>
    </div>
    <!-- ADRESA -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-geo-alt me-2"></i>
                Adresa
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row">

                <div class="col-md-8 mb-3">
                    <label asp-for="Company.Street"
                           class="form-label">
                        Ulice
                    </label>
                    <input asp-for="Company.Street"
                           class="form-control"
                           placeholder="Např. Dlouhá" />
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Company.HouseNumber"
                           class="form-label">
                        Číslo popisné / orientační
                    </label>
                    <input asp-for="Company.HouseNumber"
                           class="form-control"
                           placeholder="123/5" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.CountryId"
                           class="form-label">Stát</label>
                    <select asp-for="Company.CountryId"
                            asp-items="Model.Countries"
                            class="form-select">
                        <option value="">-- Vyberte stát --</option>
                    </select>
                </div>

                
                
                <div class="col-md-6 mb-3">
                    <label class="form-label">PSČ</label>

                    <input type="hidden" asp-for="Company.CityId" />

                    <div class="position-relative">
                        <input type="text"
                               id="postalCodeSearch"
                               class="form-control"
                               placeholder="Zadejte PSČ..."
                               autocomplete="off" />

                        <div id="postalCodeResults"
                             class="list-group position-absolute w-100 shadow-sm"
                             style="z-index:1000; display:none;">
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Město</label>

                    <div class="position-relative">
                        <input type="text"
                               id="cityNameSearch"
                               class="form-control"
                               placeholder="Zadejte město..."
                               autocomplete="off" />

                        <div id="cityNameResults"
                             class="list-group position-absolute w-100 shadow-sm"
                             style="z-index:1000; display:none;">
                        </div>
                    </div>
                </div>



            </div>
        </div>
    </div>
    <!-- BANKOVNÍ SPOJENÍ -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-bank me-2"></i>
                Bankovní spojení
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.AccountNumber"
                           class="form-label">Číslo účtu</label>
                    <input asp-for="Company.AccountNumber"
                           class="form-control"
                           placeholder="Např. 123456789/0800" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.BankId"
                           class="form-label">Banka</label>
                    <select asp-for="Company.BankId"
                            asp-items="Model.Banks"
                            class="form-select">
                        <option value="">-- Vyberte banku --</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- NDA -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-lock me-2"></i>
                Dohoda o mlčenlivosti (NDA)
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row">

                <div class="col-12 mb-3">
                    <div class="form-check">
                        <input asp-for="Company.NdaSigned"
                               class="form-check-input"
                               type="checkbox" />
                        <label asp-for="Company.NdaSigned"
                               class="form-check-label fw-semibold">
                            NDA podepsáno
                        </label>
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Company.NdaDocumentUrl"
                           class="form-label">
                        Odkaz na dokument
                    </label>
                    <input asp-for="Company.NdaDocumentUrl"
                           class="form-control"
                           placeholder="https://..." />
                    <span asp-validation-for="Company.NdaDocumentUrl"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.NdaValidFrom"
                           class="form-label">
                        Platnost od
                    </label>
                    <input asp-for="Company.NdaValidFrom"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Company.NdaValidTo"
                           class="form-label">
                        Platnost do
                    </label>
                    <input asp-for="Company.NdaValidTo"
                           type="date"
                           class="form-control" />
                </div>

            </div>
        </div>
    </div>

    <!-- POZNÁMKA -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-card-text me-2"></i>
                Ostatní informace
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="mb-3">
                <label asp-for="Company.Notes"
                       class="form-label">Poznámka</label>
                <textarea asp-for="Company.Notes"
                          class="form-control"
                          rows="4"
                          placeholder="Doplňující informace o společnosti..."></textarea>
            </div>
        </div>
    </div>

    <!-- TLAČÍTKA -->
    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Zrušit
        </a>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>
            @(Model.NameDuplicateWarning
                ? "Uložit i přesto"
                : "Uložit firmu")
        </button>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const postalInput = document.getElementById("postalCodeSearch");
            const cityInput = document.getElementById("cityNameSearch");
            const cityIdInput = document.getElementById("Company_CityId");
            const countrySelect = document.getElementById("Company_CountryId");

            const postalResults = document.getElementById("postalCodeResults");
            const cityResults = document.getElementById("cityNameResults");

                   const searchUrl = '@Url.Page("./Create", "SearchCities")';
        const companySearchUrl = '@Url.Page("./Create", "SearchCompanies")';


        let timers = {};
        let companyTimers = {};
        let companyRequests = {};

        
        // ========================================
        // PRŮBĚŽNÁ KONTROLA DUPLICIT FIREM
        // ========================================

        const companyNameInput = document.getElementById("Company_Name");
        const companyIcoInput = document.getElementById("Company_ICO");

        const companyNameResults = document.getElementById("companyNameResults");
        const companyIcoResults = document.getElementById("companyIcoResults");

        async function searchCompanies(term, searchType, resultsElement) {

            const requestId = (companyRequests[searchType] || 0) + 1;
            companyRequests[searchType] = requestId;

            const normalizedTerm = searchType === "ico"
                ? term.replace(/\D/g, "")
                : term.trim();

            const minimumLength = searchType === "name" ? 2 : 3;

            if (normalizedTerm.length < minimumLength) {
                resultsElement.style.display = "none";
                return;
            }

            const url = new URL(companySearchUrl, window.location.origin);

            url.searchParams.set("term", normalizedTerm);
            url.searchParams.set("searchType", searchType);

            try {

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error("Chyba vyhledávání firem.");
                }

                const companies = await response.json();

                // Ignorujeme starší požadavky
                if (requestId !== companyRequests[searchType]) {
                    return;
                }

                resultsElement.innerHTML = "";

                if (companies.length === 0) {
                    resultsElement.style.display = "none";
                    return;
                }

                companies.forEach(function (company) {

                    const link = document.createElement("a");

                    link.href = company.detailsUrl;
                    link.className =
                        "list-group-item list-group-item-action";

                    const name = document.createElement("strong");
                    name.textContent = company.name;

                    link.appendChild(name);

                    if (company.ico) {
                        const ico = document.createElement("div");

                        ico.className = "small text-muted";
                        ico.textContent = "IČO: " + company.ico;

                        link.appendChild(ico);
                    }

                    resultsElement.appendChild(link);
                });

                resultsElement.style.display = "block";

            } catch (error) {

                console.error(error);
                resultsElement.style.display = "none";
            }
        }

        function attachCompanySearch(input, results, searchType) {

            input.addEventListener("input", function () {

                clearTimeout(companyTimers[searchType]);

                companyTimers[searchType] = setTimeout(function () {

                    searchCompanies(
                        input.value,
                        searchType,
                        results
                    );

                }, 300);
            });
        }

        attachCompanySearch(
            companyNameInput,
            companyNameResults,
            "name"
        );

        attachCompanySearch(
            companyIcoInput,
            companyIcoResults,
            "ico"
        );
                const aresUrl = '@Url.Page("./Create", "Ares")';

        // ========================================
        // NAČTENÍ ÚDAJŮ Z ARES
        // ========================================

        const loadAresButton = document.getElementById("loadAresButton");
        const aresMessage = document.getElementById("aresMessage");

        loadAresButton.addEventListener("click", async function () {

            const ico = companyIcoInput.value.replace(/\D/g, "");

            aresMessage.textContent = "";
            aresMessage.className = "small mt-2";

            if (ico.length !== 8) {
                aresMessage.textContent = "Zadejte platné osmimístné IČO.";
                aresMessage.classList.add("text-danger");
                return;
            }

            loadAresButton.disabled = true;
            loadAresButton.innerHTML = "Načítám...";

            try {
                const url = new URL(aresUrl, window.location.origin);
                url.searchParams.set("ico", ico);

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error("ARES momentálně neodpovídá.");
                }

                const data = await response.json();

                if (!data.success) {
                    aresMessage.textContent = data.message || "Údaje se nepodařilo načíst.";
                    aresMessage.classList.add("text-danger");
                    return;
                }

                // Základní údaje
                document.getElementById("Company_Name").value = data.name || "";
                companyIcoInput.value = data.ico || ico;
                document.getElementById("Company_DIC").value = data.dic || "";

                // Adresa
                document.getElementById("Company_Street").value = data.street || "";
                document.getElementById("Company_HouseNumber").value = data.houseNumber || "";

                postalInput.value = data.postalCode || "";
                cityInput.value = data.city || "";

                // Starý výběr města už neplatí.
                cityIdInput.value = "";

                // Nabídneme odpovídající město z vlastní databáze.
                if (data.postalCode) {
                    await searchCities(data.postalCode, postalResults, "postal");
                }

                aresMessage.textContent =
                    "Údaje byly načteny. Zkontrolujte je a vyberte odpovídající PSČ a město z nabídky.";

                aresMessage.classList.add("text-success");

            } catch (error) {
                console.error(error);

                aresMessage.textContent =
                    "Při komunikaci s ARES došlo k chybě.";

                aresMessage.classList.add("text-danger");

            } finally {
                loadAresButton.disabled = false;
                loadAresButton.innerHTML =
                    '<i class="bi bi-cloud-download"></i> Načíst z ARES';
            }
        });

        // Zavření výsledků při kliknutí mimo vyhledávání
        document.addEventListener("click", function (event) {

            if (!companyNameInput.contains(event.target) &&
                !companyNameResults.contains(event.target)) {

                companyNameResults.style.display = "none";
            }

            if (!companyIcoInput.contains(event.target) &&
                !companyIcoResults.contains(event.target)) {

                companyIcoResults.style.display = "none";
            }
        });


            function hideResults() {
                postalResults.style.display = "none";
                cityResults.style.display = "none";
            }

            function clearSelection() {
                cityIdInput.value = "";
            }

            function clearBothFields() {
                postalInput.value = "";
                cityInput.value = "";
                cityIdInput.value = "";
                hideResults();
            }

            async function searchCities(term, resultsElement, source) {

                const countryId = countrySelect.value;

                if (term.length < 2 || !countryId) {
                    resultsElement.style.display = "none";
                    return;
                }

                const url = new URL(searchUrl, window.location.origin);
                url.searchParams.set("term", term);
                url.searchParams.set("countryId", countryId);

                try {
                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("Chyba vyhledávání.");
                    }

                    const cities = await response.json();

                    resultsElement.innerHTML = "";

                    cities.forEach(function (city) {

                        const item = document.createElement("button");
                        item.type = "button";
                        item.className =
                            "list-group-item list-group-item-action";

                        item.textContent = city.label;

                        item.addEventListener("click", function () {

                            postalInput.value = city.postalCode;
                            cityInput.value = city.name;
                            cityIdInput.value = city.id;

                            hideResults();
                        });

                        resultsElement.appendChild(item);
                    });

                    if (cities.length === 0) {
                        const empty = document.createElement("div");
                        empty.className = "list-group-item text-muted";
                        empty.textContent = "Žádný výsledek.";
                        resultsElement.appendChild(empty);
                    }

                    resultsElement.style.display = "block";

                } catch (error) {
                    console.error(error);
                    resultsElement.style.display = "none";
                }
            }

            function attachSearch(input, results, source) {

                input.addEventListener("input", function () {

                    clearTimeout(timers[source]);

                    clearSelection();

                    // Při změně jednoho pole smažeme starou dvojici.
                    if (source === "postal") {
                        cityInput.value = "";
                    } else {
                        postalInput.value = "";
                    }

                    const term = input.value.trim();

                    timers[source] = setTimeout(function () {
                        searchCities(term, results, source);
                    }, 250);
                });
            }

            attachSearch(postalInput, postalResults, "postal");
            attachSearch(cityInput, cityResults, "city");

            countrySelect.addEventListener("change", function () {
                clearBothFields();
            });

            document.addEventListener("click", function (event) {

                if (!postalInput.contains(event.target) &&
                    !postalResults.contains(event.target) &&
                    !cityInput.contains(event.target) &&
                    !cityResults.contains(event.target)) {

                    hideResults();
                }
            });

        });
    </script>

}
