
@page
@model PartnerCRM.Pages.Companies.IndexModel

@{
    ViewData["Title"] = "Firmy";
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">
            @(Model.ShowArchived ? "Archivované firmy" : "Firmy")
        </h2>
        <p class="text-muted mb-0">
            @(Model.ShowArchived
                ? "Evidence firem sloučených do jiných společností"
                : "Evidence zákazníků, partnerů a investorů")
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="./Merge" class="btn btn-outline-warning">
            <i class="bi bi-intersect"></i>
            Sloučit firmy
        </a>

        @if (!Model.ShowArchived)
        {
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Nová firma
            </a>
        }
    </div>
</div>

<div class="mb-3 d-flex gap-2">
    <a asp-page="./Index"
       asp-route-SearchTerm="@Model.SearchTerm"
       asp-route-SelectedCompanyTypeId="@Model.SelectedCompanyTypeId"
       class="btn @(Model.ShowArchived ? "btn-outline-secondary" : "btn-primary")">
        <i class="bi bi-building"></i>
        Aktivní firmy
    </a>

    <a asp-page="./Index"
       asp-route-ShowArchived="true"
       asp-route-SearchTerm="@Model.SearchTerm"
       asp-route-SelectedCompanyTypeId="@Model.SelectedCompanyTypeId"
       class="btn @(Model.ShowArchived ? "btn-secondary" : "btn-outline-secondary")">
        <i class="bi bi-archive"></i>
        Archivované firmy
    </a>
</div>


<!-- VYHLEDÁVÁNÍ A FILTRACE -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <form method="get">
            <div class="row align-items-end">

                <div class="col-md-5 mb-3 mb-md-0">
                    <label asp-for="SearchTerm" class="form-label">
                        Název firmy nebo kontaktní osoba
                    </label>

                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Zadejte název nebo jméno kontaktu..." />
                </div>

                <div class="col-md-4 mb-3 mb-md-0">
                    <label asp-for="SelectedCompanyTypeId"
                           class="form-label">
                        Typ firmy
                    </label>

                    <select asp-for="SelectedCompanyTypeId"
                            asp-items="Model.CompanyTypes"
                            class="form-select">
                        <option value="">Všechny typy</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i>
                            Hledat
                        </button>

                        <a asp-page="./Index"
                           class="btn btn-outline-secondary">
                            Vymazat
                        </a>
                    </div>
                </div>

            </div>
        </form>

    </div>
</div>

<!-- SEZNAM FIREM -->
<div class="card border-0 shadow-sm">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Název firmy</th>
                        <th>Typ firmy</th>
                        <th>IČO</th>
                        <th>DIČ</th>
                        <th>Web</th>
                        <th>Sloučeno do</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Companies.Any())
                    {
                        @foreach (var company in Model.Companies)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    <a asp-page="./Details"
                                       asp-route-id="@company.Id">
                                        @company.Name
                                    </a>
                                </td>

                                <td>
                                    @foreach (var type in company.CompanyTypes)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">
                                            @type.Name
                                        </span>
                                    }
                                </td>

                                <td>@company.ICO</td>
                                <td>@company.DIC</td>
                                <td>@company.Website</td>
                                <td>
    @if (company.IsMerged && company.MergedIntoCompany != null)
    {
        <a asp-page="./Details"
           asp-route-id="@company.MergedIntoCompany.Id">
            @company.MergedIntoCompany.Name
        </a>

        <div class="text-muted small">
            @(company.MergedAt?.ToLocalTime().ToString("dd.MM.yyyy") ?? "")
        </div>
    }
    else
    {
        <span class="text-muted">—</span>
    }
</td>
                               <td class="text-end text-nowrap">
    <a asp-page="./Details"
       asp-route-id="@company.Id"
       class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-eye"></i>
        Detail
    </a>

    @if (!company.IsMerged)
    {
        <a asp-page="./Edit"
           asp-route-id="@company.Id"
           class="btn btn-sm btn-outline-primary">
            <i class="bi bi-pencil"></i>
            Upravit
        </a>

        <a asp-page="./Delete"
           asp-route-id="@company.Id"
           class="btn btn-sm btn-outline-danger">
            <i class="bi bi-trash"></i>
            Smazat
        </a>
    }
</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                Žádné firmy neodpovídají zadaným kritériím.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <div class="text-muted small mt-3">
            Počet zobrazených firem: @Model.Companies.Count
        </div>

    </div>
</div>
