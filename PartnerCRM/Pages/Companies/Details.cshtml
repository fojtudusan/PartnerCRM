
@page "{id:int}"
@model PartnerCRM.Pages.Companies.DetailsModel

@{
    ViewData["Title"] = "Detail firmy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-building me-2"></i>@Model.Company.Name
        </h2>
        <p class="text-muted mb-0">Detail firmy</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Zpět na seznam
        </a>

        @if (!Model.Company.IsMerged)
        {
            <a asp-page="./Edit"
               asp-route-id="@Model.Company.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Upravit
            </a>
        }
    </div>
</div>

@if (Model.Company.IsMerged)
{
    <div class="alert alert-warning">
        <h5 class="alert-heading">
            <i class="bi bi-archive me-2"></i>Firma byla sloučena
        </h5>

        <p class="mb-1">
            Tato firma je archivovaná.
        </p>

        @if (Model.Company.MergedIntoCompany != null)
        {
            <p class="mb-0">
                Sloučena do firmy:
                <a asp-page="./Details"
                   asp-route-id="@Model.Company.MergedIntoCompany.Id">
                    @Model.Company.MergedIntoCompany.Name
                </a>
            </p>
        }

        @if (Model.Company.MergedAt.HasValue)
        {
            <small class="text-muted">
                Datum sloučení: @Model.Company.MergedAt.Value.ToString("dd.MM.yyyy")
            </small>
        }
    </div>
}

<div class="row g-4">

    <!-- Základní údaje -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Základní údaje
                </h5>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Název firmy</dt>
                    <dd class="col-sm-8">@Model.Company.Name</dd>

                    <dt class="col-sm-4">IČO</dt>
                    <dd class="col-sm-8">@(Model.Company.ICO ?? "—")</dd>

                    <dt class="col-sm-4">DIČ</dt>
                    <dd class="col-sm-8">@(Model.Company.DIC ?? "—")</dd>

                    <dt class="col-sm-4">Typ firmy</dt>
                    <dd class="col-sm-8">
                        @if (Model.Company.CompanyTypes != null &&
                             Model.Company.CompanyTypes.Any())
                        {
                            @foreach (var type in Model.Company.CompanyTypes)
                            {
                                <span class="badge bg-secondary me-1 mb-1">
                                    @type.Name
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Neuvedeno</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Kontaktní údaje -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-geo-alt me-2"></i>Adresa a kontakty
                </h5>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ulice</dt>
                    <dd class="col-sm-8">
                        @Model.Company.Street
                        @Model.Company.HouseNumber
                    </dd>

                    <dt class="col-sm-4">Město</dt>
                    <dd class="col-sm-8">
                        @Model.Company.City?.Name
                    </dd>

                    <dt class="col-sm-4">PSČ</dt>
                    <dd class="col-sm-8">
                        @Model.Company.City?.PostalCode
                    </dd>

                    <dt class="col-sm-4">Stát</dt>
                    <dd class="col-sm-8">
                        @Model.Company.Country?.Name
                    </dd>

                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">
                        @Model.Company.Phone
                    </dd>

                    <dt class="col-sm-4">Fax</dt>
                    <dd class="col-sm-8">
                        @Model.Company.Fax
                    </dd>

                    <dt class="col-sm-4">E-mail</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.Company.Email))
                        {
                            <a href="mailto:@Model.Company.Email">
                                @Model.Company.Email
                            </a>
                        }
                    </dd>

                    <dt class="col-sm-4">Web</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(Model.Company.Website))
                        {
                            <a href="@Model.Company.Website"
                               target="_blank"
                               rel="noopener noreferrer">
                                @Model.Company.Website
                            </a>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Poznámky -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-card-text me-2"></i>Poznámky
                </h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.Company.Notes))
                {
                    @Model.Company.Notes
                }
                else
                {
                    <span class="text-muted">Bez poznámek.</span>
                }
            </div>
        </div>
    </div>

    <!-- Kontakty ve firmě -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-people me-2"></i>Kontakty ve firmě
                </h5>

                @if (!Model.Company.IsMerged)
                {
                    <a asp-page="/Contacts/Create"
                       asp-route-companyId="@Model.Company.Id"
                       class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Přidat kontakt
                    </a>
                }
            </div>

            <div class="card-body p-0">
                @if (Model.Employments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Jméno</th>
                                    <th>Pozice</th>
                                    <th>E-mail</th>
                                    <th>Telefon</th>
                                    <th>Období</th>
                                    <th>Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var employment in Model.Employments)
                                {
                                    <tr>
                                        <td>
                                            <a asp-page="/Contacts/Details"
                                               asp-route-id="@employment.ContactId">
                                                @employment.Contact.FirstName
                                                @employment.Contact.LastName
                                            </a>
                                        </td>
                                        <td>@employment.Position</td>
                                        <td>@employment.Contact.Email</td>
                                        <td>@employment.Contact.Phone</td>
                                        <td>
                                            @employment.DateFrom.ToString("dd.MM.yyyy")
                                            –
                                            @(employment.IsCurrent
                                                ? "současnost"
                                                : employment.DateTo?.ToString("dd.MM.yyyy"))
                                        </td>
                                        <td>
                                            @if (employment.IsPrimary)
                                            {
                                                <span class="badge bg-primary">
                                                    Hlavní kontakt
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">
                        U firmy nejsou evidovány žádné aktivní kontakty.
                    </p>
                }
            </div>
        </div>
    </div>

    <!-- Historie aktivit -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>Historie aktivit
                </h5>

                @if (!Model.Company.IsMerged)
                {
                    <a asp-page="/Activities/Create"
                       asp-route-companyId="@Model.Company.Id"
                       class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Nová aktivita
                    </a>
                }
            </div>

            <div class="card-body p-0">
                @if (Model.Activities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Datum</th>
                                    <th>Kontakt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in Model.Activities)
                                {
                                    <tr>
                                        <td>
                                            <a asp-page="/Activities/Details"
                                               asp-route-id="@activity.Id">
                                                @activity.ActivityDate.ToString("dd.MM.yyyy")
                                            </a>
                                        </td>
                                        <td>
                                            @if (activity.Contact != null)
                                            {
                                                @activity.Contact.FirstName
                                                @activity.Contact.LastName
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">
                        U firmy zatím nejsou evidovány žádné aktivity.
                    </p>
                }
            </div>
        </div>
    </div>

</div>
