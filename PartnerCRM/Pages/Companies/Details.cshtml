
@page "{id:int}"
@model PartnerCRM.Pages.Companies.DetailsModel

@{
    ViewData["Title"] = "Detail firmy";
}

<!-- HLAVIČKA -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@Model.Company.Name</h2>
        <p class="text-muted mb-0">Detail firmy</p>
    </div>

    <div class="d-flex gap-2">
        @if (!Model.Company.IsMerged)
        {
            <a asp-page="./Edit"
               asp-route-id="@Model.Company.Id"
               class="btn btn-outline-primary">
                <i class="bi bi-pencil"></i>
                Upravit firmu
            </a>
        }

        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Zpět na seznam
        </a>
    </div>
</div>

@if (Model.Company.IsMerged)
{
    <div class="alert alert-warning mb-4">
        <h5>
            <i class="bi bi-archive me-2"></i>
            Archivovaná firma – sloučena
        </h5>

        <p class="mb-2">
            Tento záznam byl sloučen a již není aktivní.
        </p>

        <p class="mb-2">
            <strong>Datum sloučení:</strong>
            @(Model.Company.MergedAt?.ToLocalTime()
                .ToString("dd.MM.yyyy HH:mm") ?? "Neuvedeno")
        </p>

        @if (Model.Company.MergedIntoCompany != null)
        {
            <p class="mb-0">
                <strong>Sloučeno do firmy:</strong>
                <a asp-page="./Details"
                   asp-route-id="@Model.Company.MergedIntoCompany.Id"
                   class="fw-semibold">
                    @Model.Company.MergedIntoCompany.Name
                </a>
            </p>
        }
    </div>
}

<!-- ZÁKLADNÍ ÚDAJE -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-building me-2"></i>
            Základní údaje
        </h5>
    </div>

    <div class="card-body p-4">
        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Název firmy:</strong><br />
                @Model.Company.Name
            </div>

            <div class="col-md-6 mb-3">
                <strong>Typ firmy:</strong><br />

                @if (Model.Company.CompanyTypes.Any())
                {
                    @foreach (var type in Model.Company.CompanyTypes)
                    {
                        <span class="badge bg-light text-dark border me-1 mb-1">
                            @type.Name
                        </span>
                    }
                }
                else
                {
                    <span>—</span>
                }
            </div>

            <div class="col-md-6 mb-3">
                <strong>IČO:</strong><br />
                @(Model.Company.ICO ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>DIČ:</strong><br />
                @(Model.Company.DIC ?? "—")
            </div>

        </div>
    </div>
</div>

<!-- KONTAKTNÍ ÚDAJE -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-telephone me-2"></i>
            Kontaktní údaje
        </h5>
    </div>

    <div class="card-body p-4">
        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Telefon:</strong><br />
                @(Model.Company.Phone ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>Fax:</strong><br />
                @(Model.Company.Fax ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>E-mail:</strong><br />
                @if (!string.IsNullOrWhiteSpace(Model.Company.Email))
                {
                    <a href="mailto:@Model.Company.Email">
                        @Model.Company.Email
                    </a>
                }
                else
                {
                    <span>—</span>
                }
            </div>

            <div class="col-md-6 mb-3">
                <strong>Webové stránky:</strong><br />

                @if (!string.IsNullOrWhiteSpace(Model.Company.Website))
                {
                    var website = Model.Company.Website.Trim();

                    if (!website.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                        && !website.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                    {
                        website = "https://" + website;
                    }

                    <a href="@website" target="_blank" rel="noopener noreferrer">
                        @Model.Company.Website
                    </a>
                }
                else
                {
                    <span>—</span>
                }
            </div>

        </div>
    </div>
</div>

<!-- ADRESA -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-geo-alt me-2"></i>
            Adresa
        </h5>
    </div>

    <div class="card-body p-4">
        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Ulice:</strong><br />
                @(Model.Company.Street ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>Číslo popisné / orientační:</strong><br />
                @(Model.Company.HouseNumber ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>PSČ:</strong><br />
                @(Model.Company.City?.PostalCode ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>Město:</strong><br />
                @(Model.Company.City?.Name ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>Stát:</strong><br />
                @(Model.Company.Country?.Name ?? "—")
            </div>

        </div>
    </div>
</div>

<!-- BANKOVNÍ SPOJENÍ -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-bank me-2"></i>
            Bankovní spojení
        </h5>
    </div>

    <div class="card-body p-4">
        <div class="row">

            <div class="col-md-6 mb-3">
                <strong>Číslo účtu:</strong><br />
                @(Model.Company.AccountNumber ?? "—")
            </div>

            <div class="col-md-6 mb-3">
                <strong>Banka:</strong><br />
                @(Model.Company.Bank?.Name ?? "—")

                @if (Model.Company.Bank != null)
                {
                    <span class="text-muted">
                        (@Model.Company.Bank.BankCode)
                    </span>
                }
            </div>

        </div>
    </div>
</div>

<!-- POZNÁMKY -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-card-text me-2"></i>
            Ostatní informace
        </h5>
    </div>

    <div class="card-body p-4">
        <div class="mb-3">
            <strong>Poznámka:</strong><br />
            @if (!string.IsNullOrWhiteSpace(Model.Company.Notes))
            {
                @Model.Company.Notes
            }
            else
            {
                <span>—</span>
            }
        </div>

        <div>
            <strong>Datum založení záznamu:</strong><br />
            @Model.Company.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        </div>
    </div>
</div>

<!-- KONTAKTNÍ OSOBY -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Kontaktní osoby</h4>

    @if (!Model.Company.IsMerged)
    {
        <div class="d-flex gap-2">
            <a asp-page="/Companies/AddContact"
               asp-route-id="@Model.Company.Id"
               class="btn btn-outline-primary">
                <i class="bi bi-person-plus"></i>
                Přidat existující kontakt
            </a>

            <a asp-page="/Contacts/Create"
               asp-route-companyId="@Model.Company.Id"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Nový kontakt
            </a>
        </div>
    }
</div>


<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">

        @if (Model.Employments.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Jméno</th>
                            <th>Pozice</th>
                            <th>E-mail</th>
                            <th>Telefon</th>
                            <th>Hlavní kontakt</th>
                            <th>Akce</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employment in Model.Employments)
                        {
                            var contact = employment.Contact;

                            <tr>
                                <td class="fw-semibold">
                                    @contact.FirstName @contact.LastName
                                </td>

                                <td>@employment.Position</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(contact.Email))
                                    {
                                        <a href="mailto:@contact.Email">
                                            @contact.Email
                                        </a>
                                    }
                                </td>

                                <td>@contact.Phone</td>

                                <td>
                                    @if (contact.IsPrimary)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                </td>

                                <td>
                                    <a asp-page="/Contacts/Edit"
                                       asp-route-id="@contact.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                        Upravit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-muted">
                @(Model.Company.IsMerged
                    ? "Kontakty byly při sloučení převedeny do zachované firmy."
                    : "Tato firma zatím nemá žádné aktivně působící kontaktní osoby.")
            </div>
        }

    </div>
</div>

<!-- HISTORIE AKTIVIT -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Historie aktivit</h4>

    @if (!Model.Company.IsMerged)
    {
        <a asp-page="/Activities/Create"
           asp-route-companyId="@Model.Company.Id"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Nová aktivita
        </a>
    }
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">

        @if (Model.Activities.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Datum</th>
                            <th>Typ</th>
                            <th>Předmět</th>
                            <th>Kontaktní osoba</th>
                            <th>Výsledek</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var activity in Model.Activities)
                        {
                            <tr>
                                <td>
                                    @activity.ActivityDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    @{
                                        var badgeClass = activity.Type switch
                                        {
                                            "Telefonát" => "bg-primary",
                                            "E-mail" => "bg-info text-dark",
                                            "Schůzka" => "bg-success",
                                            "Online jednání" => "bg-info text-dark",
                                            "Poznámka" => "bg-warning text-dark",
                                            _ => "bg-light text-dark"
                                        };
                                    }

                                    <span class="badge @badgeClass">
                                        @activity.Type
                                    </span>
                                </td>

                                <td>
                                    <a asp-page="/Activities/Edit"
                                       asp-route-id="@activity.Id"
                                       class="text-decoration-none">
                                        @activity.Subject
                                    </a>
                                </td>

                                <td>
                                    @if (activity.Contact != null)
                                    {
                                        @activity.Contact.FirstName
                                        @:
                                        @activity.Contact.LastName
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>

                                <td>@activity.Result</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-4 text-muted">
                @(Model.Company.IsMerged
                    ? "Aktivity byly při sloučení převedeny do zachované firmy."
                    : "U této firmy zatím nejsou zaznamenány žádné aktivity.")
            </div>
        }

    </div>
</div>
